1 REM ***********************************
2 REM BUBTEST - BUBBLE / FDC TEST SUITE
3 REM DRIVE 0 = BUBBLE, DRIVE 1 = FLOPPY
4 REM
5 REM CREATES ONLY ZZ* FILES AND KILLS
6 REM EVERY ONE OF THEM.  NEVER FORMATS.
7 REM
8 REM THERE IS NO ON ERROR GOTO IN THIS
9 REM BASIC, SO ANY ?XX ERROR STOPS THE
10 REM RUN - WHICH IS ITSELF A FAILURE,
11 REM AND THE LINE NUMBER SAYS WHERE.
12 REM
13 REM THE STRESS TESTS ARE 5000, 6000 AND
14 REM 6200.  WHAT MAKES THEM WORTH HAVING
15 REM IS THAT THEY ARE LONGER THAN A
16 REM SECTOR, GO THROUGH THE READ PATH
17 REM THAT ONCE DAMAGED FILES, AND ARE
18 REM COMPARED BYTE FOR BYTE.
19 REM ***********************************
20 CLEAR 3000,28671:REM $6FFF - NO &H IN THIS BASIC
30 NT=0:NF=0:D=0
40 CLS:PRINT"BUBBLE / FDC TEST SUITE"
50 PRINT"0=BUBBLE  1=FLOPPY":PRINT
60 REM ---- FREE SPACE BEFORE WE START ----
70 FOR D=0 TO 1:GOSUB 8500:NEXT D
80 PRINT
100 REM ================================
101 REM  PER DRIVE TESTS
102 REM ================================
110 FOR D=0 TO 1
120 DR$=RIGHT$(STR$(D),1)
130 PRINT"--- DRIVE ";DR$;" ---"
140 F$="ZZSEQ.DAT:"+DR$
150 G0=FREE(D)
160 GOSUB 1000:REM SEQUENTIAL WRITE/READ
170 GOSUB 1200:REM EOF / LOC / LOF
180 GOSUB 1400:REM WRITE# AND COMMAS
190 GOSUB 1600:REM MULTI GRANULE FILE
200 GOSUB 1800:REM RENAME
210 GOSUB 2000:REM KILL AND SPACE BACK
220 GOSUB 2200:REM SAVE / ASCII SAVE
230 GOSUB 2400:REM SAVEM / LOADM
240 GOSUB 2600:REM COPY WITHIN A DRIVE
250 GOSUB 2800:REM DSKI$ READ ONLY
252 GOSUB 5000:REM LONG FILE, READ BACK EXACTLY
260 NEXT D
270 PRINT
300 REM ================================
301 REM  CROSS DEVICE TESTS
302 REM ================================
310 PRINT"--- ACROSS DEVICES ---"
320 GOSUB 3000:REM COPY 0 TO 1
330 GOSUB 3200:REM COPY 1 TO 0
332 GOSUB 6000:REM A COPY BIG ENOUGH TO MATTER
334 GOSUB 6200:REM TWO FILES OPEN AT ONCE
340 GOSUB 3400:REM DEFAULT DRIVE
350 GOSUB 3600:REM VERIFY ON/OFF, UNLOAD
355 GOSUB 3800:REM LINE INPUT#, THE SHORT VERSION
360 PRINT
400 REM ---- SUMMARY ----
410 PRINT"--------------------------------"
420 PRINT NT;"TESTS";NF;"FAILED"
430 IF NF=0 THEN PRINT"ALL PASSED"
440 DRIVE 0
445 GOTO 4000:REM ASCII LOAD - CHAINS AWAY, NEVER COMES BACK
450 END
1000 REM ---- SEQUENTIAL WRITE / READ ----
1010 OPEN"O",#1,F$
1020 PRINT#1,"LINE ONE"
1030 PRINT#1,42
1040 PRINT#1,"LINE THREE"
1050 CLOSE#1
1060 T$="SEQ WRITE":OK=(FREE(D)<G0):GOSUB 9000
1070 OPEN"I",#1,F$
1080 INPUT#1,A$:INPUT#1,N:INPUT#1,B$
1090 CLOSE#1
1100 T$="SEQ READ"
1110 OK=(A$="LINE ONE")*(N=42)*(B$="LINE THREE")
1120 GOSUB 9000
1130 RETURN
1200 REM ---- EOF / LOC / LOF ----
1210 OPEN"I",#1,F$
1220 E1=EOF(1)
1230 LF=LOF(1):LC=LOC(1)
1240 INPUT#1,A$:INPUT#1,A$:INPUT#1,A$
1250 E2=EOF(1)
1260 CLOSE#1
1270 T$="EOF":OK=(E1=0)*(E2<>0):GOSUB 9000
1280 T$="LOF":OK=(LF>0):GOSUB 9000
1290 T$="LOC":OK=(LC>=0):GOSUB 9000
1300 RETURN
1400 REM ---- WRITE# QUOTES STRINGS ----
1410 REM A COMMA INSIDE THE STRING ONLY
1420 REM SURVIVES INPUT# IF WRITE# QUOTED
1430 REM IT, SO THIS TESTS BOTH ENDS.
1440 OPEN"O",#1,F$
1450 WRITE#1,"RED,GREEN",123
1460 CLOSE#1
1470 OPEN"I",#1,F$
1480 INPUT#1,A$,N
1490 CLOSE#1
1500 T$="WRITE#":OK=(A$="RED,GREEN")*(N=123)
1510 GOSUB 9000
1520 RETURN
1600 REM ---- FILE THAT SPANS GRANULES ----
1610 REM 500 NUMBERS IS ABOUT 2500 BYTES,
1620 REM MORE THAN ONE 2304 BYTE GRANULE.
1630 PRINT"  (WRITING 500 RECORDS)"
1640 OPEN"O",#1,F$
1650 FOR I=1 TO 500:PRINT#1,I:NEXT I
1660 CLOSE#1
1670 OPEN"I",#1,F$
1680 S=0:FOR I=1 TO 500:INPUT#1,N:S=S+N:NEXT I
1690 T$="EOF AT END":OK=(EOF(1)<>0):GOSUB 9000
1700 CLOSE#1
1710 T$="MULTI GRANULE":OK=(S=125250):GOSUB 9000
1720 RETURN
1800 REM ---- RENAME ----
1810 R$="ZZREN.DAT:"+DR$
1820 RENAME F$ TO R$
1830 OPEN"I",#1,R$
1840 INPUT#1,N
1850 CLOSE#1
1860 T$="RENAME":OK=(N=1):GOSUB 9000
1870 RENAME R$ TO F$
1880 RETURN
2000 REM ---- KILL GIVES THE SPACE BACK ----
2010 KILL F$
2020 T$="KILL":OK=(FREE(D)=G0):GOSUB 9000
2030 RETURN
2200 REM ---- SAVE, CRUNCHED AND ASCII ----
2210 REM SAVES THIS PROGRAM UNDER A TEMP
2220 REM NAME.  IT IS NEVER LOADED BACK -
2230 REM THAT WOULD REPLACE THE RUNNING
2240 REM PROGRAM - SO IT IS CHECKED BY
2250 REM SPACE USED AND THEN KILLED.
2260 SAVE"ZZPROG:"+DR$
2270 T$="SAVE":OK=(FREE(D)<G0):GOSUB 9000
2280 REM SAVE"NAME",A IS NOT TESTED HERE.
2282 REM AN ASCII SAVE FINISHES THROUGH
2284 REM THE LINE INPUT HOOK, WHICH CLEARS
2286 REM THE VARIABLES AND ENDS THE RUN -
2288 REM DISK BASIC BEHAVES THE SAME WAY,
2290 REM SO IT IS A QUIRK AND NOT A FAULT.
2292 REM IT HAS TO BE TRIED BY HAND:
2294 REM   SAVE"ZZASC:0",A  THEN  DIR0
2300 KILL"ZZPROG.BAS:"+DR$
2320 T$="KILL SAVED":OK=(FREE(D)=G0):GOSUB 9000
2330 RETURN
2400 REM ---- SAVEM / LOADM ----
2410 REM CLEAR PUT THE TOP OF BASIC AT
2420 REM 28671, SO 28672 ($7000) UP IS OURS.
2430 FOR I=0 TO 31:POKE 28672+I,(I*7)AND 255:NEXT I
2440 SAVEM"ZZBIN:"+DR$,28672,28703,28672
2450 FOR I=0 TO 31:POKE 28672+I,0:NEXT I
2460 LOADM"ZZBIN:"+DR$
2470 OK=1
2480 FOR I=0 TO 31
2490 IF PEEK(28672+I)<>((I*7)AND 255) THEN OK=0
2500 NEXT I
2510 T$="SAVEM/LOADM":GOSUB 9000
2520 KILL"ZZBIN.BIN:"+DR$
2530 RETURN
2600 REM ---- COPY WITHIN ONE DRIVE ----
2610 OPEN"O",#1,F$
2620 PRINT#1,"COPY SOURCE"
2630 CLOSE#1
2640 REM COPY TAKES NO DEFAULT EXTENSION,
2650 REM SO BOTH NAMES NEED ONE SPELLED
2660 REM OUT OR IT LOOKS FOR A BLANK ONE.
2670 COPY F$ TO "ZZCPY.DAT:"+DR$
2680 OPEN"I",#1,"ZZCPY.DAT:"+DR$
2690 INPUT#1,A$
2700 CLOSE#1
2710 T$="COPY SAME DRV":OK=(A$="COPY SOURCE"):GOSUB 9000
2720 KILL"ZZCPY.DAT:"+DR$
2730 KILL F$
2740 T$="SPACE BACK":OK=(FREE(D)=G0):GOSUB 9000
2750 RETURN
2800 REM ---- DSKI$ HANDS BACK A SECTOR ----
2810 REM TRACK 17 SECTOR 3 IS THE FIRST
2820 REM DIRECTORY SECTOR ON BOTH DEVICES.
2830 REM THIS ONLY CHECKS THE SHAPE OF WHAT
2835 REM COMES BACK.  WHETHER READING LEAVES
2838 REM THE DISK ALONE IS TESTED AT 5000.
2840 DSKI$ D,17,3,A$,B$
2850 T$="DSKI$ SIZE":OK=(LEN(A$)=128)*(LEN(B$)=128)
2860 GOSUB 9000
2870 RETURN
3000 REM ---- COPY BUBBLE TO FLOPPY ----
3010 OPEN"O",#1,"ZZX.DAT:0"
3020 PRINT#1,"FROM BUBBLE"
3030 CLOSE#1
3040 COPY"ZZX.DAT:0" TO "ZZX.DAT:1"
3050 OPEN"I",#1,"ZZX.DAT:1"
3060 INPUT#1,A$
3070 CLOSE#1
3080 T$="COPY 0 TO 1":OK=(A$="FROM BUBBLE"):GOSUB 9000
3090 KILL"ZZX.DAT:0":KILL"ZZX.DAT:1"
3100 RETURN
3200 REM ---- COPY FLOPPY TO BUBBLE ----
3210 OPEN"O",#1,"ZZY.DAT:1"
3220 PRINT#1,"FROM FLOPPY"
3230 CLOSE#1
3240 COPY"ZZY.DAT:1" TO "ZZY.DAT:0"
3250 OPEN"I",#1,"ZZY.DAT:0"
3260 INPUT#1,A$
3270 CLOSE#1
3280 T$="COPY 1 TO 0":OK=(A$="FROM FLOPPY"):GOSUB 9000
3290 KILL"ZZY.DAT:1":KILL"ZZY.DAT:0"
3300 RETURN
3400 REM ---- DRIVE SETS THE DEFAULT ----
3410 REM WITH NO :N SUFFIX A FILE SHOULD
3420 REM LAND ON WHATEVER DRIVE SELECTED.
3430 H1=FREE(1)
3440 DRIVE 1
3450 OPEN"O",#1,"ZZDEF.DAT"
3460 PRINT#1,"DEFAULT DRIVE"
3470 CLOSE#1
3480 T$="DRIVE 1":OK=(FREE(1)<H1):GOSUB 9000
3490 KILL"ZZDEF.DAT:1"
3500 DRIVE 0
3510 T$="DRIVE 0":OK=(FREE(1)=H1):GOSUB 9000
3520 RETURN
3600 REM ---- VERIFY AND UNLOAD ----
3610 REM NEITHER REPORTS ANYTHING, SO THE
3620 REM TEST IS THAT THEY DO NOT ERROR
3630 REM AND THE DRIVES STILL WORK AFTER.
3640 VERIFY ON
3650 OPEN"O",#1,"ZZV.DAT:0"
3660 PRINT#1,"VERIFIED"
3670 CLOSE#1
3680 VERIFY OFF
3690 OPEN"I",#1,"ZZV.DAT:0"
3700 INPUT#1,A$
3710 CLOSE#1
3720 T$="VERIFY ON":OK=(A$="VERIFIED"):GOSUB 9000
3730 KILL"ZZV.DAT:0"
3740 UNLOAD
3750 T$="UNLOAD":OK=(FREE(0)>0):GOSUB 9000
3760 RETURN
3800 REM ---- LINE INPUT# ----
3810 REM ONE SHORT LINE.  THIS USED TO COME
3820 REM BACK AS "H HR" BECAUSE THE READ
3830 REM PATH ATE TWO BYTES FOR EVERY ONE
3840 REM IT KEPT.  IT IS KEPT AS THE CHEAP
3850 REM SMOKE TEST FOR THAT; THE SEARCHING
3860 REM VERSION, LONG ENOUGH TO REACH THE
3870 REM PART THAT DAMAGED THE FILE, IS THE
3880 REM ONE AT 5000.
3900 OPEN"O",#1,"ZZLI.DAT:0"
3910 PRINT#1,"HI THERE"
3920 CLOSE#1
3930 OPEN"I",#1,"ZZLI.DAT:0"
3940 LINE INPUT#1,A$
3950 CLOSE#1
3960 T$="LINE INPUT#":OK=(A$="HI THERE"):GOSUB 9000
3970 IF OK=0 THEN PRINT"  GOT [";A$;"]"
3980 KILL"ZZLI.DAT:0"
3990 RETURN
4000 REM ---- ASCII LOAD, THE LAST TEST ----
4002 REM LOADING A PROGRAM REPLACES THE ONE
4004 REM THAT IS RUNNING, SO THIS CANNOT BE
4006 REM A SUBROUTINE AND CANNOT COME
4008 REM BEFORE THE SUMMARY.
4010 REM
4012 REM AN ASCII LISTING IS THE ONLY THING
4014 REM THAT GOES THROUGH BASIC'S DIRECT
4016 REM MODE LOOP AS IF IT WERE TYPED, SO
4018 REM IT IS THE ONLY WAY TO REACH THAT
4020 REM CODE FROM A TEST.  ZZASC IS WRITTEN
4022 REM LONGER THAN A SECTOR, CHAINED TO,
4024 REM AND THEN CHECKS ITS OWN TEXT BACK
4026 REM OFF THE DISK BEFORE TIDYING UP.
4030 PRINT:PRINT"--- ASCII LOAD (DRIVE 1) ---"
4040 Q$=CHR$(34):A$="ZZASC.BAS:1"
4050 OPEN"O",#1,A$
4060 FOR I=1 TO 12:PRINT#1,MID$(STR$(I),2);" REM ";STRING$(44,65+I):NEXT I
4070 PRINT#1,"9000 B=0"
4080 PRINT#1,"9010 OPEN";Q$;"I";Q$;",#1,";Q$;"ZZASC.BAS:1";Q$
4090 PRINT#1,"9020 FOR I=1 TO 12"
4100 PRINT#1,"9030 LINE INPUT#1,R$"
4110 PRINT#1,"9040 IF R$<>MID$(STR$(I),2)+";Q$;" REM ";Q$;"+STRING$(44,65+I) THEN B=B+1"
4120 PRINT#1,"9050 NEXT I"
4130 PRINT#1,"9060 CLOSE#1"
4140 PRINT#1,"9070 IF B=0 THEN PRINT";Q$;"ASCII LOAD     OK";Q$;" ELSE PRINT";Q$;"ASCII LOAD     ** FAIL **";Q$
4150 PRINT#1,"9080 KILL";Q$;"ZZASC.BAS:1";Q$
4160 PRINT#1,"9090 END"
4170 CLOSE#1
4180 PRINT"  CHAINING TO ";A$
4190 RUN"ZZASC.BAS:1"
5000 REM ---- LONG FILE, READ BACK EXACTLY ----
5002 REM THIS IS THE TEST THAT WOULD HAVE
5004 REM CAUGHT THE WORST BUG THIS ROM HAS
5006 REM HAD.  READING A FILE THROUGH THE
5008 REM LINE INPUT PATH USED TO WRITE THE
5010 REM ECHOED BYTE BACK INTO THE FILE'S
5012 REM OWN BUFFER: IT ATE EVERY OTHER
5014 REM BYTE, AND ONCE THE BUFFER POINTER
5016 REM WRAPPED PAST 256 IT FLUSHED THE
5018 REM WRECKAGE BACK OUT TO DISK.
5020 REM
5022 REM NOTHING HERE IS ACCIDENTAL:
5024 REM  - LONGER THAN A SECTOR AND THAN A
5026 REM    GRANULE, SO THE WRAP HAPPENS
5028 REM  - READ WITH LINE INPUT#, WHICH IS
5030 REM    THE PATH THAT BROKE.  INPUT#
5032 REM    PARSES ITEMS ITSELF AND MISSES IT
5034 REM  - COMPARED BYTE FOR BYTE, NOT BY
5036 REM    LENGTH OR BY A CHECKSUM
5038 REM  - READ TWICE, SO A READ THAT
5040 REM    CHANGES THE FILE SHOWS UP
5042 REM  - AND THE SECTORS THEMSELVES ARE
5044 REM    COMPARED BEFORE AND AFTER
5050 NL=48:L1$="ZZLONG.DAT:"+DR$
5060 PRINT"  (";MID$(STR$(NL),2);" LINES, ABOUT 2700 BYTES)"
5070 OPEN"O",#1,L1$
5080 FOR I=1 TO NL:GOSUB 5400:PRINT#1,L$:NEXT I
5090 CLOSE#1
5100 REM WHERE ON THE DISK DID IT LAND?
5110 NM$="ZZLONG  ":EX$="DAT":GOSUB 5600
5120 T$="LOCATE FILE":OK=(GR>=0):GOSUB 9000
5130 IF GR<0 THEN KILL L1$:RETURN
5140 GOSUB 5760:REM GRANULE GR -> TRACK TR, SECTOR SE
5150 DSKI$ D,TR,SE,P1$,P2$:REM THE FILE'S FIRST DATA SECTOR
5160 DSKI$ D,17,2,P3$,P4$:REM THE ALLOCATION TABLE
5162 REM A SHORT PASS FIRST, SO THAT A MILD
5164 REM FAULT - A WRONG BYTE HERE OR THERE
5166 REM - IS REPORTED AND THE RUN CARRIES
5168 REM ON.  A READER THAT EATS BYTES IS
5169 REM NOT MILD: IT NEVER FINDS THE END OF
5171 REM A LINE, READS ON PAST THE END OF
5172 REM THE FILE, AND STOPS THE RUN.  THAT
5173 REM IS WHAT THE WARNING BELOW IS FOR.
5174 PRINT"  READING BACK.  ?IE HERE MEANS"
5175 PRINT"  THE READ PATH EATS BYTES."
5176 NP=6:GOSUB 5200
5177 IF BD=0 THEN 5180
5178 T$="LONG READ":OK=0:GOSUB 9000:GOSUB 5900
5179 GOTO 5198
5180 NP=NL:GOSUB 5200
5182 T$="LONG READ":OK=(BD=0):GOSUB 9000
5184 IF BD<>0 THEN GOSUB 5900
5186 NP=NL:GOSUB 5200:REM AGAIN - IT MUST READ THE SAME
5188 T$="RE-READ SAME":OK=(BD=0):GOSUB 9000
5190 IF BD<>0 THEN GOSUB 5900
5198 GOSUB 5800:KILL L1$:RETURN
5200 REM READ IT BACK, COUNT THE MISMATCHES
5202 REM EOF IS TESTED BEFORE EVERY LINE
5203 REM AND NOT AFTERWARDS.  A READ THAT
5204 REM EATS BYTES RUNS OFF THE END, AND
5205 REM ?IE WOULD STOP THE RUN BEFORE THE
5206 REM SECTOR CHECKS BELOW GET THEIR SAY -
5207 REM AND THOSE ARE THE ONES THAT SHOW
5208 REM WHETHER THE FILE WAS DAMAGED.
5210 BD=0:XI=0:X$=""
5220 OPEN"I",#1,L1$
5230 FOR I=1 TO NP
5240 GOSUB 5400
5250 IF EOF(1) THEN GOSUB 5300:GOTO 5270
5255 LINE INPUT#1,R$
5260 IF R$<>L$ THEN BD=BD+1:IF XI=0 THEN XI=I:X$=R$:XW$=L$
5270 NEXT I
5280 CLOSE#1
5290 RETURN
5300 BD=BD+1:IF XI=0 THEN XI=I:X$="(FILE ENDED EARLY)":XW$=L$
5310 RETURN
5400 REM THE TEXT LINE I SHOULD HOLD.
5410 REM A NUMBER THAT CHANGES EVERY LINE
5420 REM AND A LETTER THAT CHANGES EVERY
5430 REM LINE, SO EVERY KIND OF SLIP - A
5440 REM DROPPED BYTE, A DOUBLED ONE, A
5450 REM WHOLE LINE OUT OF STEP - SHOWS.
5460 C=65+I-INT(I/26)*26
5470 L$=MID$(STR$(1000+I),2)+" "+STRING$(50,C)
5480 RETURN
5600 REM FIND NM$ + EX$ IN THE DIRECTORY.
5610 REM RETURNS GR, THE FIRST GRANULE, OR
5620 REM -1.  A DIRECTORY SECTOR HOLDS 8
5630 REM ENTRIES OF 32 BYTES, AND DSKI$
5640 REM HANDS IT OVER AS TWO HALVES OF 4.
5650 GR=-1
5660 FOR SC=3 TO 11
5670 DSKI$ D,17,SC,A$,B$
5680 FOR H=0 TO 1
5690 IF H=0 THEN E$=A$ ELSE E$=B$
5700 FOR EN=0 TO 3:O=EN*32+1
5710 IF MID$(E$,O,8)=NM$ AND MID$(E$,O+8,3)=EX$ THEN GR=ASC(MID$(E$,O+13,1))
5720 NEXT EN
5730 NEXT H
5740 NEXT SC
5750 RETURN
5760 REM GRANULE GR -> TRACK TR, SECTOR SE.
5770 REM TWO GRANULES TO A TRACK, AND THE
5780 REM DIRECTORY TRACK IS SKIPPED OVER.
5785 TR=INT(GR/2):IF TR>=17 THEN TR=TR+1
5790 SE=1+(GR-INT(GR/2)*2)*9
5795 RETURN
5800 REM DID READING CHANGE THE DISK?
5810 DSKI$ D,TR,SE,A$,B$
5820 T$="DATA UNTOUCHED":OK=(A$=P1$)*(B$=P2$):GOSUB 9000
5830 DSKI$ D,17,2,A$,B$
5840 T$="FAT UNTOUCHED":OK=(A$=P3$)*(B$=P4$):GOSUB 9000
5850 RETURN
5900 REM SHOW THE FIRST LINE THAT WAS WRONG
5910 PRINT"  ";MID$(STR$(BD),2);" BAD, FIRST IS LINE";XI
5920 PRINT"  WANT [";LEFT$(XW$,16);"]"
5930 PRINT"  GOT  [";LEFT$(X$,16);"]"
5940 RETURN
6000 REM ---- A COPY BIG ENOUGH TO MATTER ----
6002 REM THE COPY TESTS ABOVE MOVE ELEVEN
6004 REM BYTES, WHICH NEVER LEAVES THE
6006 REM FIRST SECTOR OF THE FIRST GRANULE.
6008 REM THIS ONE IS BIGGER THAN A GRANULE,
6010 REM CROSSES DEVICES, AND IS COMPARED
6012 REM LINE BY LINE AT THE FAR END.
6020 NL=48
6030 PRINT"  (WRITE, COPY, COMPARE)"
6040 L1$="ZZBIG.DAT:0"
6050 OPEN"O",#1,L1$
6060 FOR I=1 TO NL:GOSUB 5400:PRINT#1,L$:NEXT I
6070 CLOSE#1
6080 COPY"ZZBIG.DAT:0" TO "ZZBIG.DAT:1"
6090 L1$="ZZBIG.DAT:1":NP=NL:GOSUB 5200
6100 T$="LONG COPY 0-1":OK=(BD=0):GOSUB 9000
6110 IF BD<>0 THEN GOSUB 5900
6120 L1$="ZZBIG.DAT:0":NP=NL:GOSUB 5200
6130 T$="COPY LEFT SRC":OK=(BD=0):GOSUB 9000
6140 IF BD<>0 THEN GOSUB 5900
6150 KILL"ZZBIG.DAT:0":KILL"ZZBIG.DAT:1"
6160 RETURN
6200 REM ---- TWO FILES OPEN AT ONCE ----
6202 REM READING ONE FILE WHILE WRITING
6204 REM ANOTHER IS WHERE A DEVICE NUMBER
6206 REM MIX-UP SHOWS ITSELF: THE BYTE
6208 REM MEANT FOR ONE FILE LANDS IN THE
6210 REM OTHER'S BUFFER.  THAT IS THE EXACT
6212 REM SHAPE OF THE BUG THE TEST AT 5000
6214 REM IS FOR, SO IT IS WORTH ITS OWN.
6216 REM ONE FILE IS ON EACH DEVICE, WHICH
6218 REM ALSO MAKES DSKCON SWITCH DRIVES ON
6220 REM EVERY SINGLE LINE.
6230 NL=24
6240 PRINT"  (READING 0 AND WRITING 1)"
6250 L1$="ZZSRC.DAT:0"
6260 OPEN"O",#1,L1$
6270 FOR I=1 TO NL:GOSUB 5400:PRINT#1,L$:NEXT I
6280 CLOSE#1
6290 OPEN"I",#1,"ZZSRC.DAT:0"
6300 OPEN"O",#2,"ZZDST.DAT:1"
6310 FOR I=1 TO NL:LINE INPUT#1,R$:PRINT#2,R$:NEXT I
6320 CLOSE#1:CLOSE#2
6330 L1$="ZZDST.DAT:1":NP=NL:GOSUB 5200
6340 T$="TWO FILES":OK=(BD=0):GOSUB 9000
6350 IF BD<>0 THEN GOSUB 5900
6360 L1$="ZZSRC.DAT:0":NP=NL:GOSUB 5200
6370 T$="SOURCE INTACT":OK=(BD=0):GOSUB 9000
6380 IF BD<>0 THEN GOSUB 5900
6390 KILL"ZZSRC.DAT:0":KILL"ZZDST.DAT:1"
6400 RETURN
8500 REM ---- REPORT FREE SPACE ----
8510 PRINT"DRIVE";D;"HAS";FREE(D);"GRANULES"
8520 RETURN
9000 REM ---- CHECK: T$ = NAME, OK = FLAG ----
9010 NT=NT+1
9020 T$=LEFT$(T$+"              ",14)
9030 IF OK<>0 THEN PRINT T$;" OK":RETURN
9040 NF=NF+1
9050 PRINT T$;" ** FAIL **"
9060 RETURN
