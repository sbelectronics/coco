1 REM BUBALT ALTERNATE BUBBLE SUITE
2 REM ***********************************
3 REM A SECOND, INDEPENDENT SET OF TESTS
4 REM COVERING THE SAME GROUND AS BUBTEST
5 REM AND BUBRAND, DONE DIFFERENTLY:
6 REM  - CHECKSUMS, NOT STRING COMPARES
7 REM  - WRITE# AND LINE INPUT#
8 REM  - FIELDS ON ARRAY ELEMENTS
9 REM  - RECORDS READ BACK IN REVERSE
10 REM  - THE DIRECTORY AND FAT SECTORS
11 REM    READ RAW WITH DSKI$ AND CHECKED
12 REM    AGAINST WHAT BASIC REPORTS
13 REM
14 REM DRIVE 0 = BUBBLE, DRIVE 1 = FLOPPY.
15 REM ONLY ZZ* FILES; ALL KILLED; NEVER
16 REM FORMATS.  ANY ?XX ERROR IS A FAIL.
17 REM A SMALL DISK (THE EMULATOR) MEANS
18 REM DRIVE 0 ONLY AND SHORT FILES.
19 REM ***********************************
20 CLEAR 3000:DIM F$(2),MB(8)
21 REM THE SAVEM SCRATCH AT 2100 IS MB(),
22 REM NOT RESERVED HIGH MEMORY, SO THIS RUNS
23 REM ON A REAL MACHINE AND ON THE EMULATOR
24 REM ALIKE.  IT IS AN ARRAY RATHER THAN A
25 REM STRING BECAUSE ARRAYS KEEP THEIR
26 REM ADDRESS: A STRING GETS MOVED BY THE
27 REM GARBAGE COLLECTOR, AND POKES AIMED AT
28 REM WHERE IT USED TO BE LAND ON WHATEVER
29 REM TOOK ITS PLACE.
30 REM BP IS SET WHERE IT IS USED, AT 2129
35 NT=0:NF=0:FL$="":EM=0:IF FREE(0)<20 THEN EM=1
40 ND=1:IF EM THEN ND=0
50 REM DISK GEOMETRY FOR THE RAW READS:
51 REM DT DIRECTORY TRACK, DS ITS LAST
52 REM SECTOR, SG SECTORS PER GRANULE,
53 REM GT GRANULES PER TRACK, GM GRANULES.
60 DT=17:DS=11:SG=9:GT=2:GM=68
70 IF EM THEN DT=1:DS=6:SG=3:GT=4:GM=8
80 CLS:PRINT"ALTERNATE BUBBLE SUITE"
90 IF EM THEN PRINT"(SMALL DISK: DRIVE 0, SHORT FILES)"
95 PRINT
100 FOR D=0 TO ND
110 DR$=RIGHT$(STR$(D),1)
120 PRINT"--- DRIVE ";DR$;" ---"
130 F$="ZZALT.DAT:"+DR$
140 G0=FREE(D)
150 GOSUB 1000:REM WRITE# / LINE INPUT#
160 GOSUB 1200:REM EOF LOOP, LOF IN SECTORS
170 GOSUB 1400:REM DIRECTORY ENTRY, FAT
180 GOSUB 1600:REM RENAME SEEN IN THE DIRECTORY
190 GOSUB 1800:REM KILL SEEN IN THE DIRECTORY
200 GOSUB 2000:REM SAVE HEADER, LOADM OFFSET
210 GOSUB 2200:REM COPY, SECTORS COMPARED
220 GOSUB 2400:REM DIRECT: ARRAY FIELDS, RSET
230 GOSUB 4000:REM DIRECT: LENGTH IN DIRECTORY
240 GOSUB 2800:REM SEQUENTIAL AND DIRECT TOGETHER
250 T$="SPACE BACK":OK=(FREE(D)=G0):GOSUB 9000
260 NEXT D
270 IF ND=0 THEN 400
300 PRINT"--- ACROSS DEVICES ---"
310 GOSUB 3000:REM SEQUENTIAL ON 0, DIRECT ON 1
320 GOSUB 3200:REM DRIVE DEFAULT SEEN IN DIRECTORY
400 PRINT:PRINT"--------------------------------"
410 PRINT NT;"TESTS";NF;"FAILED"
420 IF NF=0 THEN PRINT"ALL PASSED" ELSE PRINT"FAILED:";FL$
430 DRIVE 0
440 END
1000 REM ---- WRITE# / LINE INPUT# ----
1010 REM WRITE# QUOTES STRINGS AND PUTS
1020 REM COMMAS BETWEEN ITEMS.  READ THE
1030 REM WHOLE LINE BACK AND CHECK ITS
1040 REM EXACT SHAPE BY CHECKSUM.
1050 OPEN"O",#1,F$
1060 WRITE#1,"ALPHA",12,"BE,TA"
1070 WRITE#1,-3.5
1080 CLOSE#1
1090 OPEN"I",#1,F$
1100 LINE INPUT#1,R1$:LINE INPUT#1,R2$
1110 CLOSE#1
1120 Z$=CHR$(34)+"ALPHA"+CHR$(34)+", 12,"+CHR$(34)+"BE,TA"+CHR$(34)
1130 GOSUB 8300:E1=CK:Z$=R1$:GOSUB 8300
1140 T$="WRITE# SHAPE":OK=(CK=E1)*(R2$="-3.5"):GOSUB 9000
1150 REM AND INPUT# HAS TO SPLIT IT AGAIN
1160 OPEN"I",#1,F$
1170 INPUT#1,A$,N,B$
1180 CLOSE#1
1190 T$="INPUT# SPLITS":OK=(A$="ALPHA")*(N=12)*(B$="BE,TA"):GOSUB 9000
1195 RETURN
1200 REM ---- EOF LOOP, LOF IN SECTORS ----
1210 REM N LINES OF 50, READ WITH A LOOP
1220 REM THAT ASKS EOF BEFORE EVERY LINE.
1230 REM LOF IS SECTORS: 52 BYTES A LINE
1240 REM WITH THE RETURN, ROUNDED UP.
1250 NL=40:IF EM THEN NL=12
1260 OPEN"O",#1,F$
1270 FOR I=1 TO NL:PRINT#1,STRING$(50,64+I-INT(I/26)*26):NEXT I
1280 CLOSE#1
1290 OPEN"I",#1,F$
1300 N=0:CK=0
1310 IF EOF(1) THEN 1350
1320 LINE INPUT#1,R$:N=N+1
1330 IF R$<>STRING$(50,64+N-INT(N/26)*26) THEN CK=CK+1
1340 GOTO 1310
1350 LF=LOF(1):CLOSE#1
1360 T$="EOF LOOP COUNT":OK=(N=NL)*(CK=0):GOSUB 9000
1370 T$="LOF SECTORS":OK=(LF=INT((NL*51+255)/256)):GOSUB 9000
1380 RETURN
1400 REM ---- DIRECTORY ENTRY, FAT ----
1410 REM THE FILE FROM 1200 IS STILL THERE.
1420 REM ITS ENTRY SAYS TYPE 1 (DATA), ASCII,
1430 REM AND A FIRST GRANULE; THE FAT SAYS
1440 REM HOW MANY GRANULES ARE FREE, AND
1450 REM FREE() HAD BETTER AGREE WITH IT.
1460 NM$="ZZALT   ":EX$="DAT":GOSUB 8100
1470 T$="DIR ENTRY":OK=(GR>=0)*(TY=1)*(AF=255):GOSUB 9000
1480 T$="DIR LAST SECTOR":OK=(LS=NL*51-INT(NL*51/256)*256):GOSUB 9000
1490 GOSUB 8400
1500 T$="FAT VS FREE":OK=(FF=FREE(D)):GOSUB 9000
1510 REM THE FIRST DATA SECTOR IS THE FIRST
1520 REM LINE, AND IS WHERE THE ENTRY SAYS.
1530 GOSUB 8500:DSKI$ D,TR,SE,A$,B$
1540 T$="DATA WHERE SAID":OK=(LEFT$(A$,50)=STRING$(50,"A")):GOSUB 9000
1550 RETURN
1600 REM ---- RENAME SEEN IN THE DIRECTORY ----
1610 RENAME F$ TO "ZZNEW.TXT:"+DR$
1620 NM$="ZZNEW   ":EX$="TXT":GOSUB 8100:G1=GR
1630 NM$="ZZALT   ":EX$="DAT":GOSUB 8100
1640 T$="RENAME IN DIR":OK=(G1>=0)*(GR<0):GOSUB 9000
1650 RENAME "ZZNEW.TXT:"+DR$ TO F$
1660 RETURN
1800 REM ---- KILL SEEN IN THE DIRECTORY ----
1810 GOSUB 8400:F1=FF
1820 KILL F$
1830 NM$="ZZALT   ":EX$="DAT":GOSUB 8100
1840 GOSUB 8400
1850 T$="KILL IN DIR":OK=(GR<0):GOSUB 9000
1860 T$="KILL FREES FAT":OK=(FF>F1)*(FF=FREE(D)):GOSUB 9000
1870 RETURN
2000 REM ---- SAVE HEADER, LOADM OFFSET ----
2010 REM A SAVED PROGRAM STARTS $FF THEN
2020 REM ITS LENGTH, WHICH IS VARTAB LESS
2030 REM TXTTAB.  READ THE SECTOR RAW.
2032 REM SAVING THIS PROGRAM NEEDS MORE ROOM
2034 REM THAN A SMALL DISK HAS, SO THAT HALF
2036 REM IS SKIPPED THERE.  LOADM STILL RUNS.
2038 IF EM THEN 2110
2040 SAVE"ZZP:"+DR$
2050 NM$="ZZP     ":EX$="BAS":GOSUB 8100
2060 GOSUB 8500:DSKI$ D,TR,SE,A$,B$
2070 PL=PEEK(27)*256+PEEK(28)-PEEK(25)*256-PEEK(26)
2080 T$="SAVE HEADER":OK=(ASC(A$)=255)*(ASC(MID$(A$,2,1))*256+ASC(MID$(A$,3,1))=PL):GOSUB 9000
2090 T$="SAVE TYPE 0 B":OK=(TY=0)*(AF=0):GOSUB 9000
2100 KILL"ZZP.BAS:"+DR$
2110 REM SAVEM THE FIRST 16 BYTES OF MB(),
2112 REM THEN LOAD THEM 16 HIGHER - INTO THE
2114 REM SECOND HALF OF THE SAME ARRAY - WITH
2116 REM THE OFFSET ARGUMENT.
2118 REM THE ADDRESS IS TAKEN HERE AND NOT AT
2120 REM THE TOP, BECAUSE CREATING A VARIABLE
2122 REM MOVES THE ARRAY AREA UP: AN ADDRESS
2124 REM KEPT FROM EARLIER WOULD BY NOW POINT
2126 REM AT THE VARIABLES INSTEAD, AND THE
2128 REM POKES WOULD LAND ON THEM.
2129 BP=VARPTR(MB(0))
2130 FOR I=0 TO 15:POKE BP+I,255-I*3:POKE BP+16+I,0:NEXT I
2140 SAVEM"ZZM:"+DR$,BP,BP+15,BP
2150 LOADM"ZZM:"+DR$,16
2160 OK=1:FOR I=0 TO 15:IF PEEK(BP+16+I)<>255-I*3 THEN OK=0
2170 NEXT I:T$="LOADM OFFSET":GOSUB 9000
2180 KILL"ZZM.BIN:"+DR$
2190 RETURN
2200 REM ---- COPY, SECTORS COMPARED ----
2210 REM WRITE A FILE OF KNOWN BYTES, COPY
2220 REM IT, AND COMPARE THE FIRST SECTOR
2230 REM OF EACH RAW, PLUS THE LENGTHS IN
2240 REM THE TWO DIRECTORY ENTRIES.
2250 OPEN"O",#1,F$
2260 FOR I=1 TO 9:PRINT#1,STRING$(30,48+I):NEXT I
2270 CLOSE#1
2280 COPY F$ TO "ZZCP.DAT:"+DR$
2290 NM$="ZZALT   ":EX$="DAT":GOSUB 8100:L1=LS:GOSUB 8500:DSKI$ D,TR,SE,A$,B$
2300 NM$="ZZCP    ":EX$="DAT":GOSUB 8100:L2=LS:GOSUB 8500:DSKI$ D,TR,SE,C$,E$
2310 T$="COPY SECTOR":OK=(A$=C$)*(B$=E$)*(L1=L2)*(L1=23):GOSUB 9000
2320 KILL"ZZCP.DAT:"+DR$:KILL F$
2330 RETURN
2400 REM ---- DIRECT: ARRAY FIELDS, RSET ----
2410 REM FIELDS ON ARRAY ELEMENTS, FILLED
2420 REM WITH RSET, WRITTEN WITH A BARE PUT
2430 REM THAT COUNTS ON ITS OWN, READ BACK
2440 REM BACKWARDS AND CHECKSUMMED.
2450 NR=30:IF EM THEN NR=10
2460 REM F$() IS DIMENSIONED AT THE TOP: ONCE, NOT ONCE PER DRIVE
2470 OPEN"D",#1,F$,24
2480 FIELD#1,8 AS F$(0),8 AS F$(1),8 AS F$(2)
2490 FOR I=1 TO NR
2500 RSET F$(0)=STR$(I):RSET F$(1)=STR$(I*I):LSET F$(2)=CHR$(64+I-INT(I/26)*26)
2510 PUT#1
2520 NEXT I
2530 T$="BARE PUT COUNTS":OK=(LOC(1)=NR+1)*(LOF(1)=NR):GOSUB 9000
2540 CLOSE#1
2550 OPEN"D",#1,F$,24
2560 FIELD#1,8 AS F$(0),8 AS F$(1),8 AS F$(2)
2570 CK=0:E1=0
2580 FOR I=NR TO 1 STEP -1
2590 GET#1,I
2600 CK=CK+VAL(F$(0))*3+VAL(F$(1))+ASC(F$(2))
2610 E1=E1+I*3+I*I+64+I-INT(I/26)*26
2620 NEXT I
2630 T$="REVERSE CHECKSUM":OK=(CK=E1):GOSUB 9000
2640 T$="RSET RIGHT":OK=(RIGHT$(F$(0),2)=" 1")*(LEFT$(F$(0),1)=" "):GOSUB 9000
2650 CLOSE#1
2660 RETURN
2800 REM ---- SEQUENTIAL AND DIRECT TOGETHER ----
2810 REM #1 SEQUENTIAL OUTPUT, #2 DIRECT,
2820 REM INTERLEAVED, THEN THE SEQUENTIAL
2830 REM READ WITH #2 STILL OPEN.
2840 OPEN"O",#1,F$
2850 OPEN"D",#2,"ZZD.DAT:"+DR$,16
2860 FIELD#2,16 AS A$
2870 FOR I=1 TO 6
2880 PRINT#1,"SEQ";I
2890 LSET A$="DIR"+STR$(I):PUT#2,I
2900 NEXT I
2910 CLOSE#1
2920 OPEN"I",#1,F$
2930 OK=1:FOR I=6 TO 1 STEP -1
2940 LINE INPUT#1,R$:GET#2,I
2950 IF R$<>"SEQ"+STR$(7-I)+" " THEN OK=0
2960 V$="DIR"+STR$(I)+" ":IF LEFT$(A$,LEN(V$))<>V$ THEN OK=0
2970 NEXT I
2980 CLOSE#1,#2
2990 T$="SEQ AND DIRECT":GOSUB 9000
2992 KILL F$:KILL"ZZD.DAT:"+DR$
2994 RETURN
3000 REM ---- SEQUENTIAL ON 0, DIRECT ON 1 ----
3010 H0=FREE(0):H1=FREE(1)
3020 OPEN"O",#1,"ZZS.DAT:0"
3030 OPEN"D",#2,"ZZR.DAT:1",12
3040 FIELD#2,12 AS A$
3050 FOR I=1 TO 10:WRITE#1,I*I:LSET A$=STR$(I*I):PUT#2,I:NEXT I
3060 CLOSE#1
3070 OPEN"I",#1,"ZZS.DAT:0"
3080 CK=0:FOR I=1 TO 10:INPUT#1,N:GET#2,11-I:CK=CK+N-I*I+VAL(A$)-(11-I)*(11-I):NEXT I
3090 CLOSE#1,#2
3100 T$="0 SEQ 1 DIRECT":OK=(CK=0):GOSUB 9000
3110 KILL"ZZS.DAT:0":KILL"ZZR.DAT:1"
3120 T$="BOTH SPACE BACK":OK=(FREE(0)=H0)*(FREE(1)=H1):GOSUB 9000
3130 RETURN
3200 REM ---- DRIVE DEFAULT SEEN IN DIRECTORY ----
3210 DRIVE 1
3220 OPEN"O",#1,"ZZDF.DAT":PRINT#1,"X":CLOSE#1
3230 DRIVE 0
3240 D=1:NM$="ZZDF    ":EX$="DAT":GOSUB 8100:G1=GR
3250 D=0:GOSUB 8100
3260 T$="DEFAULT DRIVE 1":OK=(G1>=0)*(GR<0):GOSUB 9000
3270 KILL"ZZDF.DAT:1"
3280 RETURN
4000 REM ---- DIRECT: LENGTH IN DIRECTORY ----
4010 REM THE FILE FROM 2400 IS STILL THERE.
4020 REM ITS LAST SECTOR HOLDS THE TAIL OF
4030 REM NR RECORDS OF 24, AND LOF WORKS
4040 REM THAT BACK INTO A RECORD COUNT.
4050 NM$="ZZALT   ":EX$="DAT":GOSUB 8100
4060 T$="DIR LST DIRECT":OK=(LS=NR*24-INT((NR*24-1)/256)*256):GOSUB 9000
4070 OPEN"D",#1,F$,24
4080 T$="LOF FROM DIR":OK=(LOF(1)=NR):GOSUB 9000
4090 REM A PUT WELL PAST THE END GROWS THE
4092 REM FILE, AND LOF FOLLOWS.
4094 FIELD#1,24 AS A$:LSET A$="FAR":PUT#1,NR+5
4096 T$="LOF AFTER GROW":OK=(LOF(1)=NR+5):GOSUB 9000
4098 CLOSE#1:KILL F$
4099 RETURN
8100 REM ---- FIND NM$ EX$ IN DRIVE D'S DIRECTORY ----
8110 REM GR FIRST GRANULE OR -1, LS BYTES IN
8120 REM THE LAST SECTOR, TY TYPE, AF ASCII.
8130 GR=-1:LS=-1:TY=-1:AF=-1
8140 FOR SC=3 TO DS
8150 DSKI$ D,DT,SC,Q1$,Q2$
8160 FOR H=0 TO 1
8170 IF H=0 THEN W$=Q1$ ELSE W$=Q2$
8180 FOR EN=0 TO 3:O=EN*32+1
8190 IF MID$(W$,O,8)<>NM$ OR MID$(W$,O+8,3)<>EX$ THEN 8230
8200 TY=ASC(MID$(W$,O+11,1)):AF=ASC(MID$(W$,O+12,1))
8210 GR=ASC(MID$(W$,O+13,1))
8220 LS=ASC(MID$(W$,O+14,1))*256+ASC(MID$(W$,O+15,1))
8230 NEXT EN
8240 NEXT H
8250 NEXT SC
8260 RETURN
8300 REM ---- CK = WEIGHTED CHECKSUM OF Z$ ----
8310 CK=0:FOR Q=1 TO LEN(Z$):CK=CK+ASC(MID$(Z$,Q,1))*Q:NEXT Q
8320 RETURN
8400 REM ---- FF = FREE GRANULES PER THE FAT ----
8410 DSKI$ D,DT,2,Q1$,Q2$:FF=0
8420 FOR Q=1 TO GM:IF ASC(MID$(Q1$,Q,1))=255 THEN FF=FF+1
8430 NEXT Q
8440 RETURN
8500 REM ---- GRANULE GR TO TRACK TR, SECTOR SE ----
8510 TR=INT(GR/GT):IF TR>=DT THEN TR=TR+1
8520 SE=1+(GR-INT(GR/GT)*GT)*SG
8530 RETURN
9000 REM ---- CHECK: T$ = NAME, OK = FLAG ----
9010 NT=NT+1
9020 U$=T$:T$=LEFT$(T$+"                ",16)
9030 IF OK<>0 THEN PRINT T$;" OK":RETURN
9040 NF=NF+1:IF LEN(FL$)<200 THEN FL$=FL$+" "+U$
9050 PRINT T$;" ** FAIL **"
9060 RETURN
