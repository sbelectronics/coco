1 REM ***********************************
2 REM BASTEST - GENERAL BASIC REGRESSION
3 REM
4 REM TOUCHES NO FILES.  CHECKS THAT THE
5 REM ROM HAS NOT BROKEN COLOR / EXTENDED
6 REM BASIC ITSELF: EXPRESSIONS, &H AND &O
7 REM CONSTANTS, STRINGS, CONTROL FLOW,
8 REM ARRAYS, GRAPHICS GET/PUT AND CLS
9 REM (THE ROM HOOKS THEIR VECTORS), AND
10 REM WHERE BASIC'S OWN PROGRAM STARTS.
11 REM
12 REM ANY ?XX ERROR STOPS THE RUN, AND
13 REM THAT IS ITSELF A FAILURE.
19 REM ***********************************
20 CLEAR 2000
21 REM NO RESERVED HIGH MEMORY: THE SCRATCH
22 REM BYTES AT 2300 COME OUT OF A STRING,
23 REM SO THIS RUNS THE SAME ON A REAL
24 REM MACHINE AND ON THE EMULATOR, WHOSE
25 REM TOP OF RAM IS MUCH LOWER.
30 REM CLS FIRST, WHILE THE SCREEN IS
31 REM STILL OURS TO CLEAR.  CLS 3 FILLS
32 REM WITH BLUE (175), PLAIN CLS WITH
33 REM SPACES (96).  CLS SHARES ITS RAM
34 REM HOOK WITH DISK GET/PUT.
40 CLS 3:C1=PEEK(1024):CLS:C2=PEEK(1024)
50 NT=0:NF=0:FL$=""
60 PRINT"BASTEST - BASIC REGRESSION":PRINT
70 T$="CLS 3":OK=(C1=175):GOSUB 9000
80 T$="CLS":OK=(C2=96):GOSUB 9000
100 GOSUB 1000:REM ARITHMETIC
110 GOSUB 1100:REM NUMERIC FUNCTIONS
120 GOSUB 1200:REM &H &O HEX$
130 GOSUB 1300:REM STRINGS
140 GOSUB 1400:REM MID$= INSTR STRING$
150 GOSUB 1500:REM CONTROL FLOW
160 GOSUB 2100:REM ARRAYS AND STRING SPACE
170 GOSUB 2200:REM DEF FN
180 GOSUB 2300:REM PEEK POKE VARPTR MEMORY
190 GOSUB 2400:REM GRAPHICS GET/PUT
200 GOSUB 2500:REM TIMER RND
400 PRINT:PRINT"--------------------------------"
410 PRINT NT;"TESTS";NF;"FAILED"
420 IF NF=0 THEN PRINT"ALL PASSED":END
430 REM THE SCREEN HOLDS 16 LINES AND THERE
431 REM ARE MORE TESTS THAN THAT, SO THE
432 REM FAILURES ARE LISTED AGAIN HERE.
440 PRINT"FAILED:";FL$
450 END
1000 REM ---- ARITHMETIC AND PRECEDENCE ----
1010 T$="PRECEDENCE":OK=(2+3*4=14)*((2+3)*4=20):GOSUB 9000
1020 T$="DIVIDE":OK=(7/2=3.5)*(1/4=.25):GOSUB 9000
1030 REM ^ SQR AND THE TRANSCENDENTALS ARE
1032 REM COMPUTED FROM EXP AND LOG, SO THEY
1034 REM ARE CLOSE RATHER THAN EXACT: LOG(1)
1036 REM COMES BACK AS 1.6E-10, NOT 0.  THESE
1038 REM ARE CHECKED TO A TOLERANCE.
1040 T$="POWER":OK=(ABS(2^10-1024)<1E-3)*(ABS(4^.5-2)<1E-6)*(ABS(2^-1-.5)<1E-6):GOSUB 9000
1045 T$="UNARY MINUS":OK=(ABS(-3^2+9)<1E-4)*(ABS((0-3)^2-9)<1E-4):GOSUB 9000
1050 T$="LARGE INT":OK=(32767+1=32768)*(65535+1=65536):GOSUB 9000
1060 T$="E NOTATION":OK=(1E3=1000)*(2.5E-1=.25):GOSUB 9000
1070 T$="MODULO":OK=(17-INT(17/5)*5=2):GOSUB 9000
1080 T$="COMPARE":OK=((3>2)=-1)*((3<2)=0)*((2=2)=-1):GOSUB 9000
1090 T$="AND OR NOT":OK=((6 AND 3)=2)*((6 OR 3)=7)*((NOT 0)=-1):GOSUB 9000
1095 RETURN
1100 REM ---- NUMERIC FUNCTIONS ----
1110 T$="INT FIX":OK=(INT(-2.5)=-3)*(FIX(-2.5)=-2)*(INT(2.5)=2):GOSUB 9000
1120 T$="ABS SGN":OK=(ABS(-7)=7)*(SGN(-7)=-1)*(SGN(0)=0)*(SGN(5)=1):GOSUB 9000
1130 T$="SQR":OK=(ABS(SQR(144)-12)<1E-5)*(ABS(SQR(2)*SQR(2)-2)<1E-5)*(SQR(0)=0):GOSUB 9000
1140 T$="TRIG":OK=(SIN(0)=0)*(ABS(COS(0)-1)<1E-6)*(ABS(ATN(1)*4-3.14159265)<1E-6):GOSUB 9000
1150 T$="EXP LOG":OK=(ABS(EXP(0)-1)<1E-6)*(ABS(LOG(1))<1E-6)*(ABS(LOG(EXP(2))-2)<1E-5):GOSUB 9000
1160 RETURN
1200 REM ---- &H &O AND HEX$ ----
1210 REM EXTENDED BASIC PARSES THESE IN ITS
1220 REM EXPRESSION HOOK.  A ROM THAT CHAINS
1230 REM THAT HOOK WRONGLY LOSES THEM WITH
1240 REM NO ERROR AT ALL, SO THEY ARE HERE.
1250 T$="&H":OK=(&H10=16)*(&HFF=255)*(&H7FFF=32767)*(&H0=0):GOSUB 9000
1260 T$="&O":OK=(&O17=15)*(&O777=511)*(&O10=8):GOSUB 9000
1270 T$="&H IN EXPR":OK=(&HA+&HB=21)*(&H100/&H10=16):GOSUB 9000
1280 T$="HEX$":OK=(HEX$(255)="FF")*(HEX$(0)="0")*(HEX$(4096)="1000"):GOSUB 9000
1290 T$="VAL &H":OK=(VAL("&HFF")=255)*(VAL("&O17")=15):GOSUB 9000
1295 RETURN
1300 REM ---- STRINGS ----
1310 A$="HELLO"
1320 T$="LEN LEFT RIGHT":OK=(LEN(A$)=5)*(LEFT$(A$,2)="HE")*(RIGHT$(A$,2)="LO"):GOSUB 9000
1330 T$="MID$":OK=(MID$(A$,2,3)="ELL")*(MID$(A$,4)="LO"):GOSUB 9000
1340 T$="ASC CHR$":OK=(ASC("A")=65)*(CHR$(66)="B")*(ASC(A$)=72):GOSUB 9000
1350 T$="STR$ VAL":OK=(STR$(42)=" 42")*(VAL("12.5")=12.5)*(VAL("  7")=7):GOSUB 9000
1360 T$="CONCAT":OK=(A$+" "+"WORLD"="HELLO WORLD"):GOSUB 9000
1370 T$="STR COMPARE":OK=("A"<"B")*("AB"<"ABC")*("ABC"="ABC")*("B">"A"):GOSUB 9000
1380 T$="EMPTY STRING":OK=(LEN("")=0)*(""+A$=A$):GOSUB 9000
1390 RETURN
1400 REM ---- MID$= INSTR STRING$ ----
1410 A$="HELLO":MID$(A$,2,2)="XY"
1420 T$="MID$ ASSIGN":OK=(A$="HXYLO"):GOSUB 9000
1430 T$="INSTR":OK=(INSTR("HELLO","LL")=3)*(INSTR(4,"HELLO","L")=4)*(INSTR("HELLO","Z")=0):GOSUB 9000
1440 T$="STRING$":OK=(STRING$(3,"Z")="ZZZ")*(STRING$(2,65)="AA")*(LEN(STRING$(255,"X"))=255):GOSUB 9000
1450 RETURN
1500 REM ---- CONTROL FLOW ----
1510 X=0:IF 1 THEN X=1 ELSE X=2
1520 Y=0:IF 0 THEN Y=1 ELSE Y=2
1530 T$="IF ELSE":OK=(X=1)*(Y=2):GOSUB 9000
1540 N=0:FOR I=10 TO 1 STEP -3:N=N+1:NEXT I
1550 T$="STEP -3":OK=(N=4)*(I=-2):GOSUB 9000
1560 N=0:FOR I=1 TO 3 STEP .5:N=N+1:NEXT I
1570 T$="STEP .5":OK=(N=5):GOSUB 9000
1580 N=0:FOR I=1 TO 3:FOR J=1 TO 4:N=N+1:NEXT J,I
1590 T$="NESTED FOR":OK=(N=12):GOSUB 9000
1600 N=0:FOR I=1 TO 0:N=N+1:NEXT I
1605 T$="FOR RUNS ONCE":OK=(N=1):GOSUB 9000
1610 DP=0:GOSUB 1690
1620 T$="GOSUB DEPTH 20":OK=(DP=20):GOSUB 9000
1630 X=2:ON X GOTO 1640,1650,1660
1640 R=1:GOTO 1670
1650 R=2:GOTO 1670
1660 R=3
1670 T$="ON GOTO":OK=(R=2):GOSUB 9000
1672 R=0:X=3:ON X GOSUB 1682,1682,1684
1674 T$="ON GOSUB":OK=(R=30):GOSUB 9000
1676 N=0:I=0
1678 I=I+1:N=N+I:IF I<10 THEN 1678
1680 T$="GOTO LOOP":OK=(N=55):GOSUB 9000
1681 RETURN
1682 R=R+10:RETURN
1684 R=R+30:RETURN
1690 DP=DP+1:IF DP<20 THEN GOSUB 1690
1695 RETURN
2100 REM ---- ARRAYS AND STRING SPACE ----
2110 DIM A(10),B(3,4),S$(5)
2120 FOR I=0 TO 10:A(I)=I*I:NEXT I
2130 S=0:FOR I=0 TO 10:S=S+A(I):NEXT I
2140 T$="1D ARRAY":OK=(S=385)*(A(7)=49):GOSUB 9000
2150 FOR I=0 TO 3:FOR J=0 TO 4:B(I,J)=I*10+J:NEXT J,I
2160 T$="2D ARRAY":OK=(B(3,4)=34)*(B(2,0)=20)*(B(0,4)=4):GOSUB 9000
2170 FOR I=0 TO 5:S$(I)=STRING$(I,"*")+STR$(I):NEXT I
2180 T$="STRING ARRAY":OK=(S$(5)="***** 5")*(S$(0)=" 0"):GOSUB 9000
2190 REM MAKE A LOT OF GARBAGE SO THE
2191 REM COLLECTOR HAS TO RUN, THEN SEE
2192 REM THAT A LIVE STRING SURVIVED IT.
2193 K$="KEEP ME":DIM G$(9)
2194 FOR I=1 TO 300:G$(I-INT(I/10)*10)=STRING$(I-INT(I/60)*60+1,"G")+STR$(I):NEXT I
2195 T$="STRING GC":OK=(K$="KEEP ME")*(RIGHT$(G$(0),4)=" 300"):GOSUB 9000
2196 RETURN
2200 REM ---- DEF FN ----
2210 DEF FNA(X)=X*X+1
2220 DEF FNB(X)=FNA(X)*2
2230 T$="DEF FN":OK=(FNA(3)=10)*(FNB(3)=20)*(FNA(-2)=5):GOSUB 9000
2240 RETURN
2300 REM ---- PEEK POKE VARPTR MEMORY ----
2310 REM A 16 BYTE STRING GIVES 16 BYTES
2320 REM THAT ARE SAFELY OURS.  VARPTR OF A
2330 REM STRING POINTS AT ITS DESCRIPTOR:
2332 REM LENGTH, SPARE, THEN THE ADDRESS.
2334 Z$=STRING$(16,32):V=VARPTR(Z$)
2336 P=PEEK(V+2)*256+PEEK(V+3)
2338 T$="STRING DESCR":OK=(PEEK(V)=16)*(P>0):GOSUB 9000
2340 FOR I=0 TO 15:POKE P+I,I*17:NEXT I
2342 OK=1:FOR I=0 TO 15:IF PEEK(P+I)<>I*17 THEN OK=0
2344 NEXT I:T$="PEEK POKE":GOSUB 9000
2346 T$="POKE SEEN IN STR":OK=(ASC(Z$)=0)*(ASC(RIGHT$(Z$,1))=255):GOSUB 9000
2360 A=1234:P=VARPTR(A)
2370 T$="VARPTR":OK=(P>0)*(PEEK(P)=139):GOSUB 9000
2380 REM DISK BASIC PUTS THE PROGRAM AT
2390 REM $2601 WITH THE DEFAULT TWO FILES,
2392 REM AND SO MUST THIS ROM, OR EVERY PEEK
2394 REM OF A PROGRAM'S OWN TEXT IS OFF.
2395 REM RUN THIS AFTER A RESET: A FILES
2396 REM COMMAND MOVES THE PROGRAM ON PURPOSE.
2397 T$="TXTTAB $2601":OK=(PEEK(25)*256+PEEK(26)=9729):GOSUB 9000
2398 T$="MEM":OK=(MEM>1000):GOSUB 9000
2399 RETURN
2400 REM ---- GRAPHICS GET/PUT ----
2410 REM DISK GET#/PUT# COMES IN THROUGH THE
2420 REM SAME HOOK AS GRAPHICS GET/PUT AND
2430 REM CLS.  ALL THREE MUST STILL WORK.
2440 DIM GA(15,15)
2450 PMODE 4,1:PCLS
2460 PSET(3,3,1):PSET(6,1,1)
2470 GET(0,0)-(7,7),GA,G
2480 P1=PPOINT(3,3):P2=PPOINT(4,4)
2490 PCLS:P3=PPOINT(3,3)
2492 PUT(8,0)-(15,7),GA,PSET
2494 P4=PPOINT(11,3):P5=PPOINT(14,1):P6=PPOINT(12,4)
2496 T$="PSET PPOINT":OK=(P1<>P2)*(P3=P2):GOSUB 9000
2497 T$="GET/PUT GRAPHIC":OK=(P4=P1)*(P5=P1)*(P6=P2):GOSUB 9000
2498 PMODE 4,1:PCLS
2499 RETURN
2500 REM ---- TIMER AND RND ----
2510 REM TIMER COUNTS 60THS, SO THE LOOP HAS
2512 REM TO LAST LONG ENOUGH TO SEE ONE TICK.
2514 TIMER=0:FOR I=1 TO 3000:NEXT I:TM=TIMER
2520 T$="TIMER RUNS":OK=(TM>0):GOSUB 9000
2530 OK=1:FOR I=1 TO 50:R=RND(10):IF R<1 OR R>10 OR R<>INT(R) THEN OK=0
2540 NEXT I:T$="RND RANGE":GOSUB 9000
2550 RETURN
9000 REM ---- CHECK: T$ = NAME, OK = FLAG ----
9010 NT=NT+1
9020 U$=T$:T$=LEFT$(T$+"              ",14)
9030 IF OK<>0 THEN PRINT T$;" OK":RETURN
9040 NF=NF+1:IF LEN(FL$)<200 THEN FL$=FL$+" "+U$
9050 PRINT T$;" ** FAIL **"
9060 RETURN
