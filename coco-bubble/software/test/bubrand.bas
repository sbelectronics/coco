1 REM ***********************************
2 REM BUBRAND - DIRECT ACCESS FILE TESTS
3 REM DRIVE 0 = BUBBLE, DRIVE 1 = FLOPPY
4 REM
5 REM OPEN "D", FIELD, GET, PUT, LSET,
6 REM RSET, MKN$, CVN, LOC, LOF, FILES,
7 REM AND PRINT#/INPUT# INSIDE A RECORD.
8 REM
9 REM CREATES ONLY ZZ* FILES AND KILLS
10 REM EVERY ONE OF THEM.  NEVER FORMATS.
11 REM ANY ?XX ERROR STOPS THE RUN - A
12 REM FAILURE, AND THE LINE SAYS WHERE.
13 REM
14 REM ON A SMALL DISK (THE EMULATOR) IT
15 REM USES DRIVE 0 ONLY AND SHORT FILES.
19 REM ***********************************
20 FILES 3,700:REM FIRST: IT CLEARS VARIABLES.  3 FILES, ROOM FOR A 600 BYTE RECORD
30 CLEAR 3000
31 REM NO RESERVED HIGH MEMORY IS NEEDED:
32 REM NOTHING HERE POKES.  LEAVING IT OUT
33 REM MEANS THIS ALSO RUNS ON THE EMULATOR,
34 REM WHOSE TOP OF RAM IS MUCH LOWER.
40 NT=0:NF=0:FL$="":EM=0:IF FREE(0)<20 THEN EM=1
50 ND=1:IF EM THEN ND=0
60 CLS:PRINT"DIRECT ACCESS FILE TESTS"
70 IF EM THEN PRINT"(SMALL DISK: DRIVE 0, SHORT FILES)"
80 PRINT
100 FOR D=0 TO ND
110 DR$=RIGHT$(STR$(D),1)
120 PRINT"--- DRIVE ";DR$;" ---"
130 F$="ZZRAN.DAT:"+DR$
140 G0=FREE(D)
150 GOSUB 1000:REM CREATE, REOPEN, GRANULES
160 GOSUB 1200:REM FIELD LSET RSET PUT GET
170 GOSUB 1400:REM BARE GET WALKS, LOC, LOF
180 GOSUB 1600:REM MKN$ / CVN
190 GOSUB 1800:REM PRINT# INPUT# IN A RECORD
200 GOSUB 2000:REM LET COPIES A FIELD
210 GOSUB 2200:REM RECORDS ACROSS SECTORS
220 GOSUB 2400:REM TWO FILES, CLOSE LOWER FIRST
230 GOSUB 2600:REM STRIDE ORDER, CHECKSUMMED
240 GOSUB 4000:REM 600 BYTE RECORD
250 T$="SPACE BACK":OK=(FREE(D)=G0):GOSUB 9000
260 NEXT D
270 IF ND=0 THEN 400
300 PRINT"--- ACROSS DEVICES ---"
310 GOSUB 3000:REM ONE DIRECT FILE PER DEVICE
400 PRINT:PRINT"--------------------------------"
410 PRINT NT;"TESTS";NF;"FAILED"
420 IF NF=0 THEN PRINT"ALL PASSED" ELSE PRINT"FAILED:";FL$
430 DRIVE 0
440 END
1000 REM ---- CREATE, REOPEN, GRANULES ----
1010 REM A DIRECT OPEN CREATES THE FILE,
1020 REM WHICH COSTS ONE GRANULE.  OPENING
1030 REM IT AGAIN MUST NOT COST ANOTHER OR
1040 REM LOSE WHAT IS IN IT.
1050 OPEN"D",#1,F$,32
1060 CLOSE#1
1070 T$="OPEN D CREATES":OK=(FREE(D)=G0-1):GOSUB 9000
1080 OPEN"D",#1,F$,32
1090 FIELD#1,32 AS A$
1100 LSET A$="FIRST RECORD"
1110 PUT#1,1
1120 CLOSE#1
1130 OPEN"R",#1,F$,32:REM R IS A SYNONYM
1140 FIELD#1,32 AS A$
1150 GET#1,1
1160 T$="REOPEN KEEPS":OK=(LEFT$(A$,12)="FIRST RECORD")*(FREE(D)=G0-1):GOSUB 9000
1170 CLOSE#1
1180 KILL F$
1190 T$="KILL DIRECT":OK=(FREE(D)=G0):GOSUB 9000
1195 RETURN
1200 REM ---- FIELD LSET RSET PUT GET ----
1210 OPEN"D",#1,F$,32
1220 FIELD#1,10 AS N$,6 AS P$,16 AS R$
1230 T$="FIELD LENGTHS":OK=(LEN(N$)=10)*(LEN(P$)=6)*(LEN(R$)=16):GOSUB 9000
1240 LSET N$="ADA":RSET P$="42":LSET R$=STRING$(20,"X")
1250 T$="LSET PADS":OK=(N$="ADA       "):GOSUB 9000
1260 T$="RSET PADS":OK=(P$="    42"):GOSUB 9000
1270 T$="LSET TRUNCS":OK=(R$=STRING$(16,"X")):GOSUB 9000
1280 PUT#1,3
1290 LSET N$="BOB":RSET P$="7":LSET R$="SECOND"
1300 PUT#1,1
1310 REM OUT OF ORDER: 3 WAS WRITTEN FIRST
1320 GET#1,3
1330 T$="GET RECORD 3":OK=(N$="ADA       ")*(P$="    42")*(R$=STRING$(16,"X")):GOSUB 9000
1340 GET#1,1
1350 T$="GET RECORD 1":OK=(N$="BOB       ")*(P$="     7")*(LEFT$(R$,6)="SECOND"):GOSUB 9000
1360 REM RECORD 2 WAS NEVER WRITTEN BUT
1370 REM SITS BETWEEN TWO THAT WERE, SO
1380 REM IT IS INSIDE THE FILE.  THEN
1390 REM OVERWRITE 3 AND CHECK 1 SURVIVES.
1392 LSET N$="CAROL":PUT#1,3
1394 GET#1,1:X$=N$:GET#1,3
1396 T$="OVERWRITE":OK=(X$="BOB       ")*(N$="CAROL     "):GOSUB 9000
1398 CLOSE#1:KILL F$
1399 RETURN
1400 REM ---- BARE GET WALKS, LOC, LOF ----
1410 OPEN"D",#1,F$,16
1420 FIELD#1,16 AS A$
1430 FOR I=1 TO 6:LSET A$="REC"+STR$(I):PUT#1:NEXT I
1440 T$="LOC AFTER PUT":OK=(LOC(1)=7):GOSUB 9000
1450 T$="LOF RECORDS":OK=(LOF(1)=6):GOSUB 9000
1460 GET#1,1:OK=1
1470 FOR I=2 TO 6:GET#1:V$="REC"+STR$(I):IF LEFT$(A$,LEN(V$))<>V$ THEN OK=0
1480 NEXT I
1490 T$="BARE GET WALKS":GOSUB 9000
1500 T$="LOC AFTER GET":OK=(LOC(1)=7):GOSUB 9000
1510 REM 16 RECORDS OF 16 IS ONE SECTOR;
1520 REM THE 17TH STARTS THE NEXT AND LOF
1530 REM HAS TO COUNT ACROSS THE BOUNDARY.
1540 FOR I=7 TO 17:LSET A$="REC"+STR$(I):PUT#1,I:NEXT I
1550 T$="LOF 2 SECTORS":OK=(LOF(1)=17):GOSUB 9000
1560 GET#1,17
1570 T$="RECORD 17":OK=(LEFT$(A$,6)="REC 17"):GOSUB 9000
1580 CLOSE#1:KILL F$
1590 RETURN
1600 REM ---- MKN$ / CVN ----
1610 REM A NUMBER PACKED INTO FIVE BYTES
1620 REM AND BACK, THROUGH A RECORD.
1630 OPEN"D",#1,F$,20
1640 FIELD#1,5 AS A$,5 AS B$,5 AS C$,5 AS D$
1650 LSET A$=MKN$(1234.5):LSET B$=MKN$(-0.125)
1660 LSET C$=MKN$(1E9):LSET D$=MKN$(0)
1670 T$="MKN$ IS 5":OK=(LEN(MKN$(7))=5):GOSUB 9000
1680 PUT#1,2:CLOSE#1
1690 OPEN"D",#1,F$,20
1700 FIELD#1,5 AS A$,5 AS B$,5 AS C$,5 AS D$
1710 GET#1,2
1720 T$="CVN ROUND TRIP":OK=(CVN(A$)=1234.5)*(CVN(B$)=-.125):GOSUB 9000
1730 T$="CVN BIG ZERO":OK=(CVN(C$)=1E9)*(CVN(D$)=0):GOSUB 9000
1740 CLOSE#1:KILL F$
1750 RETURN
1800 REM ---- PRINT# INPUT# IN A RECORD ----
1810 REM NO FIELD AT ALL: PRINT# FILLS THE
1820 REM RECORD, PUT SENDS IT, INPUT# READS
1830 REM IT BACK.  THE COMMA IS WRITTEN
1840 REM EXPLICITLY - IN A PRINT# IT WOULD
1850 REM PAD TO A TAB FIELD, AS DISK BASIC.
1860 OPEN"D",#1,F$,40
1870 PRINT#1,"RED";",";17;",";"GREEN"
1880 PUT#1,4
1890 PRINT#1,"BLUE";",";99
1900 PUT#1,2
1910 CLOSE#1
1920 OPEN"D",#1,F$,40
1930 GET#1,4:INPUT#1,A$,N,B$
1940 T$="PRINT# INPUT#":OK=(A$="RED")*(N=17)*(B$="GREEN"):GOSUB 9000
1950 GET#1,2:INPUT#1,A$,N
1960 T$="SECOND RECORD":OK=(A$="BLUE")*(N=99):GOSUB 9000
1970 CLOSE#1:KILL F$
1980 RETURN
2000 REM ---- LET COPIES A FIELD ----
2010 REM C$=A$ MUST COPY THE BYTES, NOT
2020 REM POINT C$ INTO THE RECORD, OR C$
2030 REM CHANGES UNDER THE NEXT GET.
2040 OPEN"D",#1,F$,8
2050 FIELD#1,8 AS A$
2060 LSET A$="ONE":PUT#1,1
2070 LSET A$="TWO":PUT#1,2
2080 GET#1,1:C$=A$:C2$=LEFT$(A$,3)
2090 GET#1,2
2100 T$="LET COPIES":OK=(C$="ONE     ")*(C2$="ONE")*(LEFT$(A$,3)="TWO"):GOSUB 9000
2110 CLOSE#1:KILL F$
2120 RETURN
2200 REM ---- RECORDS ACROSS SECTORS ----
2210 REM 100 BYTE RECORDS DO NOT DIVIDE A
2220 REM 256 BYTE SECTOR, SO RECORDS 3, 6,
2230 REM 8 ... STRADDLE TWO SECTORS AND
2240 REM SOME STRADDLE A GRANULE TOO.
2250 NR=12:IF EM THEN NR=8
2260 OPEN"D",#1,F$,100
2270 FIELD#1,1 AS H$,98 AS M$,1 AS E$
2280 FOR I=1 TO NR
2290 LSET H$=CHR$(64+I):LSET M$=STRING$(98,96+I):LSET E$=CHR$(64+I)
2300 PUT#1,I
2310 NEXT I
2320 CLOSE#1
2330 OPEN"D",#1,F$,100
2340 FIELD#1,1 AS H$,98 AS M$,1 AS E$
2350 OK=1:FOR I=NR TO 1 STEP -1
2360 GET#1,I
2370 IF H$<>CHR$(64+I) OR E$<>CHR$(64+I) OR M$<>STRING$(98,96+I) THEN OK=0:PRINT"  RECORD";I;"BAD"
2380 NEXT I
2390 T$="STRADDLE SECTORS":GOSUB 9000
2392 T$="LOF STRADDLED":OK=(LOF(1)=NR):GOSUB 9000
2394 CLOSE#1:KILL F$
2396 RETURN
2400 REM ---- TWO FILES, CLOSE LOWER FIRST ----
2410 REM THE SECOND FILE'S BUFFER SITS
2420 REM ABOVE THE FIRST'S.  CLOSING THE
2430 REM FIRST SLIDES IT DOWN, AND THE
2440 REM FIELDS ON IT HAVE TO FOLLOW.
2450 OPEN"D",#1,F$,32
2460 OPEN"D",#2,"ZZTWO.DAT:"+DR$,32
2470 FIELD#1,32 AS A$
2480 FIELD#2,16 AS B$,16 AS C$
2490 LSET A$="FILE ONE":LSET B$="FILE TWO":LSET C$="SECOND HALF"
2500 PUT#1,1:PUT#2,1
2510 CLOSE#1
2520 T$="FIELDS FOLLOW":OK=(LEFT$(B$,8)="FILE TWO")*(LEFT$(C$,11)="SECOND HALF"):GOSUB 9000
2530 LSET B$="STILL OK":PUT#2,2
2540 GET#2,1
2550 T$="UPPER FILE READS":OK=(LEFT$(B$,8)="FILE TWO"):GOSUB 9000
2560 GET#2,2
2570 T$="UPPER FILE WRITES":OK=(LEFT$(B$,8)="STILL OK"):GOSUB 9000
2580 CLOSE#2
2590 KILL F$:KILL"ZZTWO.DAT:"+DR$
2595 RETURN
2600 REM ---- STRIDE ORDER, CHECKSUMMED ----
2610 REM WRITE RECORDS IN A STRIDE ORDER
2620 REM THAT VISITS EACH ONCE, READ THEM
2630 REM BACK IN A DIFFERENT STRIDE, AND
2640 REM CHECKSUM WHAT COMES BACK.  37 BYTE
2650 REM RECORDS STRADDLE EVERYTHING.
2660 NR=60:IF EM THEN NR=12
2670 PRINT"  (";MID$(STR$(NR),2);" RECORDS OF 37)"
2680 OPEN"D",#1,F$,37
2690 FIELD#1,37 AS A$
2700 K=1:FOR I=1 TO NR
2710 LSET A$=STR$(K*7)+STRING$(30,65+K-INT(K/26)*26)
2720 PUT#1,K
2730 K=K+13:IF K>NR THEN K=K-NR
2740 NEXT I
2750 CLOSE#1
2760 OPEN"D",#1,F$,37
2770 FIELD#1,37 AS A$
2780 CK=0:K=1:FOR I=1 TO NR
2790 GET#1,K
2800 IF VAL(A$)<>K*7 THEN PRINT"  RECORD";K;"HAS";VAL(A$)
2810 IF MID$(A$,LEN(STR$(K*7))+1,1)<>CHR$(65+K-INT(K/26)*26) THEN PRINT"  RECORD";K;"BAD FILL"
2820 CK=CK+VAL(A$)
2830 K=K+7:IF K>NR THEN K=K-NR
2840 NEXT I
2850 T$="STRIDE CHECKSUM":OK=(CK=7*NR*(NR+1)/2):GOSUB 9000
2860 T$="LOF STRIDE":OK=(LOF(1)=NR):GOSUB 9000
2870 CLOSE#1:KILL F$
2880 RETURN
3000 REM ---- ONE DIRECT FILE PER DEVICE ----
3010 REM INTERLEAVED, SO EACH PUT AND GET
3020 REM HAS TO SELECT ITS OWN DRIVE.
3030 H0=FREE(0):H1=FREE(1)
3040 OPEN"D",#1,"ZZA.DAT:0",24
3050 OPEN"D",#2,"ZZB.DAT:1",24
3060 FIELD#1,24 AS A$:FIELD#2,24 AS B$
3070 FOR I=1 TO 8
3080 LSET A$="BUBBLE"+STR$(I):PUT#1,I
3090 LSET B$="FLOPPY"+STR$(I):PUT#2,I
3100 NEXT I
3110 OK=1:FOR I=8 TO 1 STEP -1
3120 GET#2,I:GET#1,I
3130 V$="BUBBLE"+STR$(I):IF LEFT$(A$,LEN(V$))<>V$ THEN OK=0
3140 V$="FLOPPY"+STR$(I):IF LEFT$(B$,LEN(V$))<>V$ THEN OK=0
3150 NEXT I
3160 T$="0 AND 1 TOGETHER":GOSUB 9000
3170 CLOSE#1,#2
3180 KILL"ZZA.DAT:0":KILL"ZZB.DAT:1"
3190 T$="BOTH SPACE BACK":OK=(FREE(0)=H0)*(FREE(1)=H1):GOSUB 9000
3195 RETURN
4000 REM ---- 600 BYTE RECORD ----
4010 REM LONGER THAN A SECTOR: FILES MADE
4020 REM THE ROOM FOR IT AT THE TOP.
4030 OPEN"D",#1,F$,600
4040 FIELD#1,255 AS A$,255 AS B$,90 AS C$
4050 LSET A$="A"+STRING$(253,"a")+"1"
4060 LSET B$="B"+STRING$(253,"b")+"2"
4070 LSET C$="C"+STRING$(88,"c")+"3"
4080 PUT#1,2
4090 LSET A$="X":LSET B$="Y":LSET C$="Z"
4100 PUT#1,1
4110 CLOSE#1
4120 OPEN"D",#1,F$,600
4130 FIELD#1,255 AS A$,255 AS B$,90 AS C$
4140 GET#1,2
4150 T$="600 BYTE RECORD":OK=(A$="A"+STRING$(253,"a")+"1")*(B$="B"+STRING$(253,"b")+"2")*(C$="C"+STRING$(88,"c")+"3"):GOSUB 9000
4160 GET#1,1
4170 T$="600 NEIGHBOUR":OK=(LEFT$(A$,1)="X")*(LEFT$(B$,1)="Y")*(LEFT$(C$,1)="Z")*(LOF(1)=2):GOSUB 9000
4180 CLOSE#1:KILL F$
4190 RETURN
9000 REM ---- CHECK: T$ = NAME, OK = FLAG ----
9010 NT=NT+1
9020 U$=T$:T$=LEFT$(T$+"                ",16)
9030 IF OK<>0 THEN PRINT T$;" OK":RETURN
9040 NF=NF+1:IF LEN(FL$)<200 THEN FL$=FL$+" "+U$
9050 PRINT T$;" ** FAIL **"
9060 RETURN
